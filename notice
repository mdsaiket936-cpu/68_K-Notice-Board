                <i class="fa-brands fa-facebook"></i> Made by Developer
            </a>
        </div>
    </footer>

    <!-- Toast -->
    <div id="toast" class="toast"></div>

    <!-- Back to Top -->
    <button id="backToTop" class="btn-float" title="Back to Top"><i class="fa-solid fa-arrow-up"></i></button>

    <!-- ===== MODALS ===== -->
    <div id="authModal" class="modal-overlay hidden">
        <div class="glass-panel modal-card">
            <div class="modal-header"><h3 style="font-size:1rem;"><i class="fa-solid fa-user-shield"></i> Admin Access</h3><button class="closeModal btn-icon-sm"><i class="fa-solid fa-xmark"></i></button></div>
            <form id="authForm">
                <p style="font-size:0.85rem;margin-bottom:10px;">Please enter the Security PIN:</p>
                <input type="password" id="pinInput" placeholder="••••" required autofocus style="text-align:center;padding-left:10px;font-size:1.1rem;letter-spacing:4px;">
                <div id="pinError" class="error-msg hidden">Wrong PIN</div>
                <button type="submit" class="btn-primary btn-full" style="margin-top:8px;">Unlock Dashboard</button>
            </form>
        </div>
