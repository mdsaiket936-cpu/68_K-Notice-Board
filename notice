    <div id="adminModal" class="modal-overlay hidden">
        <div class="glass-panel modal-card modal-lg">
            <div class="modal-header">
                <h3 style="font-size:1rem;"><i class="fa-solid fa-sliders"></i> Admin Dashboard</h3>
                <div class="admin-actions">
                    <button id="adminLogoutBtn" class="btn-danger-sm"><i class="fa-solid fa-right-from-bracket"></i> Logout</button>
                    <button class="closeModal btn-icon-sm"><i class="fa-solid fa-xmark"></i></button>
