                    <input type="hidden" id="noticeId">
                    <div class="form-grid">
                        <div class="form-group span-2"><label for="formTitle">Notice Title*</label><input type="text" id="formTitle" required placeholder="e.g. Midterm Examination Schedule"></div>
                        <div class="form-group"><label for="formCategory">Category*</label>
                            <select id="formCategory" required>
                                <option value="Assignment">Assignment</option><option value="Exam">Exam</option>
                                <option value="Routine">Routine</option><option value="Holiday">Holiday</option>
                                <option value="Class">Class</option><option value="Event">Event</option><option value="General" selected>General</option>
                            </select>
                        </div>
                        <div class="form-group"><label for="formDate">Date*</label><input type="date" id="formDate" required></div>
                        <div class="form-group"><label for="formTime">Time*</label><input type="time" id="formTime" required></div>
                        <div class="form-group"><label for="formPostedBy">Posted By*</label>
                            <select id="formPostedBy" required><option value="Teacher">Teacher</option><option value="CR" selected>CR</option><option value="Admin">Admin</option></select>
                        </div>
                        <div class="form-group span-2"><label for="formAttachment">Attachment URL (Optional)</label><input type="url" id="formAttachment" placeholder="https://example.com/file.pdf"></div>
                        <div class="form-group span-2"><label for="formDescription">Description (Optional)</label><textarea id="formDescription" rows="3" placeholder="Write notice details..."></textarea></div>
                        <div class="form-group checkbox-group span-2"><input type="checkbox" id="formPinned"><label for="formPinned" style="font-size:0.75rem;">Pin Notice to top (📌 Important)</label></div>
                    </div>
                    <div class="form-actions">
                        <button type="button" id="resetFormBtn" class="btn-secondary" style="font-size:0.8rem;padding:6px 14px;">Reset</button>
                        <button type="submit" class="btn-primary" id="saveNoticeBtn" style="font-size:0.8rem;padding:6px 14px;">Publish Notice</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="modal-overlay hidden">
        <div class="glass-panel modal-card modal-sm">
            <div style="text-align: center; margin-bottom: 16px;">
                <i class="fa-solid fa-triangle-exclamation" style="font-size: 2.5rem; color: var(--danger);"></i>
                <h3 style="margin-top: 8px; font-size:1.1rem; color: var(--danger);">Delete Notice?</h3>
                <p style="color: var(--text-muted); margin-top: 6px; font-size:0.85rem;">This action cannot be undone.</p>
            </div>
            <div class="modal-actions" style="display:flex;gap:8px;justify-content:center;">
                <button id="cancelDeleteBtn" class="btn-secondary" style="flex:1;font-size:0.8rem;padding:6px;">Cancel</button>
                <button id="confirmDeleteBtn" class="btn-danger" style="flex:1;font-size:0.8rem;padding:6px;">Delete</button>
            </div>
        </div>
    </div>

    <script>
        // ================================================================
        // 68_K NOTICE BOARD — FIREBASE REALTIME SYNC
        // ================================================================

        // ===== FIREBASE CONFIGURATION =====
        const firebaseConfig = {
            apiKey: "AIzaSyBhVXfzI1pvf50qXQl45wFKNnghm5lc4M8",
            authDomain: "k-notice-board.firebaseapp.com",
            projectId: "k-notice-board",
            storageBucket: "k-notice-board.firebasestorage.app",
            messagingSenderId: "560613947408",
            appId: "1:560613947408:web:ceeeb116c854e4a47af295",
            measurementId: "G-JYH14D63S0"
        };

        // ===== INIT FIREBASE =====
        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();
        const noticesCollection = db.collection('notices');

        // ===== CONSTANTS =====
        const ADMIN_PIN = '6638';
        const STORAGE_KEY = 'snb_notices';
        const THEME_KEY = 'snb_theme';

        let notices = [];
        let isAdmin = false;
        let selectedDateStr = null;
        let deleteTargetId = null;
        let currentCalendarDate = new Date();
        let isFirebaseReady = false;
        let unsubscribeFirebase = null;

        // ===== FIREBASE: REAL-TIME LISTENER =====
        function startFirebaseListener() {
            if (unsubscribeFirebase) {
                unsubscribeFirebase();
                unsubscribeFirebase = null;
            }

            unsubscribeFirebase = noticesCollection
                .orderBy('createdAt', 'desc')
                .onSnapshot((snapshot) => {
                    const newNotices = [];
                    snapshot.forEach((doc) => {
                        const data = doc.data();
                        newNotices.push({
                            id: doc.id,
                            title: data.title || 'Untitled',
                            category: data.category || 'General',
                            date: data.date || new Date().toISOString().split('T')[0],
                            time: data.time || '00:00',
                            description: data.description || '',
                            postedBy: data.postedBy || 'Admin',
                            attachment: data.attachment || '',
                            pinned: data.pinned || false,
                            createdAt: data.createdAt?.toMillis?.() || Date.now()
                        });
                    });

                    const oldIds = notices.map(n => n.id).sort().join(',');
                    const newIds = newNotices.map(n => n.id).sort().join(',');

                    if (oldIds !== newIds || JSON.stringify(notices) !== JSON.stringify(newNotices)) {
                        notices = newNotices;
                        localStorage.setItem(STORAGE_KEY, JSON.stringify(notices));
                        renderCalendar();
                        renderNotices();
                        updateSyncTime();

                        if (Notification.permission === 'granted' && notices.length > 0) {
                            const latest = notices[0];
                            new Notification('📢 New Notice', {
                                body: `"${latest.title}" - ${latest.category}`,
                                icon: '📋'
                            });
                        }
                    }

                    isFirebaseReady = true;
                }, (error) => {
                    console.error('Firebase listener error:', error);
                    loadNoticesFromCache();
                });
        }

        // ===== LOCAL STORAGE CACHE =====
        function loadNoticesFromCache() {
            const stored = localStorage.getItem(STORAGE_KEY);
            if (stored) {
                try { notices = JSON.parse(stored); } catch { notices = []; }
            } else { 
                notices = []; 
                localStorage.setItem(STORAGE_KEY, JSON.stringify(notices));
            }
            renderCalendar();
            renderNotices();
        }

        // ===== FIREBASE CRUD OPERATIONS =====
        async function addNoticeToFirebase(notice) {
            try {
                const docRef = await noticesCollection.add({
                    title: notice.title,
                    category: notice.category,
                    date: notice.date,
                    time: notice.time,
                    description: notice.description || '',
                    postedBy: notice.postedBy,
                    attachment: notice.attachment || '',
                    pinned: notice.pinned || false,
                    createdAt: firebase.firestore.FieldValue.serverTimestamp()
                });
                return docRef.id;
            } catch (error) {
                console.error('Error adding notice:', error);
                throw error;
            }
        }

        async function updateNoticeInFirebase(id, notice) {
            try {
                await noticesCollection.doc(id).update({
                    title: notice.title,
                    category: notice.category,
                    date: notice.date,
                    time: notice.time,
                    description: notice.description || '',
                    postedBy: notice.postedBy,
                    attachment: notice.attachment || '',
                    pinned: notice.pinned || false,
                    updatedAt: firebase.firestore.FieldValue.serverTimestamp()
                });
                return true;
            } catch (error) {
                console.error('Error updating notice:', error);
                throw error;
            }
        }

        async function deleteNoticeFromFirebase(id) {
            try {
                await noticesCollection.doc(id).delete();
                return true;
            } catch (error) {
                console.error('Error deleting notice:', error);
                throw error;
            }
        }

        // ===== TOAST =====
        function showToast(message, type = 'info') {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.className = `toast ${type}`;
            toast.classList.add('show');
            clearTimeout(toast._timeout);
            toast._timeout = setTimeout(() => toast.classList.remove('show'), 2500);
        }

        // ===== SHARE =====
        function shareAppLink() {
            const url = window.location.href;
            if (navigator.share) {
                navigator.share({
                    title: '68_K Notice Board',
                    text: 'Check out the latest class notices!',
                    url: url
                }).catch(() => {});
            } else {
                navigator.clipboard.writeText(url).then(() => {
                    showToast('📋 Link copied!', 'success');
                }).catch(() => {
                    prompt('Copy this link to share:', url);
                });
            }
        }

        function requestNotificationPermission() {
            if ('Notification' in window && Notification.permission === 'default') {
                Notification.requestPermission();
            }
        }

        // ===== THEME =====
        function initTheme() {
            const saved = localStorage.getItem(THEME_KEY) || 'light';
            document.documentElement.setAttribute('data-theme', saved);
            updateThemeIcon(saved);
            document.getElementById('themeToggleBtn').addEventListener('click', () => {
                const current = document.documentElement.getAttribute('data-theme');
                const next = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem(THEME_KEY, next);
                updateThemeIcon(next);
            });
        }

        function updateThemeIcon(theme) {
            const btn = document.getElementById('themeToggleBtn');
            btn.innerHTML = theme === 'dark' ? `<i class="fa-solid fa-sun"></i>` : `<i class="fa-solid fa-moon"></i>`;
        }

        // ===== REFRESH =====
        function refreshPage() {
            window.location.reload();
        }

        // ===== CALENDAR =====
        function renderCalendar() {
            const year = currentCalendarDate.getFullYear(), month = currentCalendarDate.getMonth();
            const monthNames = ["January","February","March","April","May","June","July","August","September","October","November","December"];
            document.getElementById('calendarMonthYear').textContent = `${monthNames[month]} ${year}`;
            const firstDay = new Date(year, month, 1).getDay();
            const lastDay = new Date(year, month + 1, 0).getDate();
            const container = document.getElementById('calendarDays');
            container.innerHTML = '';
            for (let i = 0; i < firstDay; i++) { const d = document.createElement('div'); d.classList.add('day','empty'); container.appendChild(d); }
            const today = new Date();
            for (let day = 1; day <= lastDay; day++) {
                const div = document.createElement('div');
                div.classList.add('day');
                div.textContent = day;
                const mStr = String(month + 1).padStart(2,'0'), dStr = String(day).padStart(2,'0');
                const formatted = `${year}-${mStr}-${dStr}`;
                if (day === today.getDate() && month === today.getMonth() && year === today.getFullYear()) div.classList.add('today');
                if (selectedDateStr === formatted) div.classList.add('selected');
                const hasNotice = notices.some(n => n.date === formatted);
                if (hasNotice) { const dot = document.createElement('span'); dot.classList.add('dot'); div.appendChild(dot); }
                div.addEventListener('click', () => {
                    selectedDateStr = formatted;
                    document.getElementById('clearDateFilter').classList.remove('hidden');
                    renderCalendar();
                    renderNotices();
                });
                container.appendChild(div);
            }
            updateSyncTime();
        }

        // ===== RENDER NOTICES =====
        function renderNotices() {
            const container = document.getElementById('noticesContainer');
            const empty = document.getElementById('emptyState');

            let filtered = notices.filter(n => {
                const matchDate = selectedDateStr ? (n.date === selectedDateStr) : true;
                return matchDate;
            });

            filtered.sort((a,b) => {
                if (a.pinned !== b.pinned) return b.pinned ? 1 : -1;
                return new Date(`${a.date}T${a.time||'00:00'}`) - new Date(`${b.date}T${b.time||'00:00'}`);
            });

            document.getElementById('feedTitle').textContent = selectedDateStr ? `Notices for ${selectedDateStr}` : 'All Notices';
            document.getElementById('noticeCount').textContent = filtered.length;
            container.innerHTML = '';

            if (filtered.length === 0) { empty.classList.remove('hidden'); } else {
                empty.classList.add('hidden');
                filtered.forEach(n => container.appendChild(createNoticeCard(n)));
            }
        }

        function createNoticeCard(notice) {
            const card = document.createElement('div');
            card.className = `glass-panel notice-card ${notice.pinned ? 'pinned' : ''}`;
            card.id = `notice-${notice.id}`;

            const pinnedBadge = notice.pinned ? `<span class="pinned-badge">📌 Important</span>` : '';
            const attachment = notice.attachment ? `<a href="${escapeHtml(notice.attachment)}" target="_blank" class="btn-action-text"><i class="fa-solid fa-paperclip"></i> Attachment</a>` : '';
            const desc = notice.description ? `<p class="notice-desc">${escapeHtml(notice.description)}</p>` : '';
            const adminControls = isAdmin ? `
                <div class="admin-card-controls">
                    <button onclick="togglePin('${notice.id}')" class="btn-icon-sm" title="${notice.pinned ? 'Unpin' : 'Pin'}"><i class="fa-solid fa-thumbtack" style="${notice.pinned ? 'color:var(--accent-pin)' : ''}"></i></button>
                    <button onclick="openEditModal('${notice.id}')" class="btn-icon-sm" title="Edit"><i class="fa-solid fa-pen"></i></button>
                    <button onclick="confirmDelete('${notice.id}')" class="btn-icon-sm" title="Delete"><i class="fa-solid fa-trash" style="color:var(--danger)"></i></button>
                </div>
            ` : '';

            card.innerHTML = `
                ${pinnedBadge}
                <div class="notice-meta">
                    <span class="notice-category">${escapeHtml(notice.category)}</span>
                    <span class="meta-item"><i class="fa-regular fa-calendar"></i> ${notice.date}</span>
                    <span class="meta-item"><i class="fa-regular fa-clock"></i> ${notice.time}</span>
                </div>
                <h3 class="notice-title">${escapeHtml(notice.title)}</h3>
                ${desc}
                <div class="notice-footer">
                    <span>Posted by: <strong>${escapeHtml(notice.postedBy)}</strong></span>
                    <div class="notice-actions">
                        ${attachment}
                        <button onclick="printNotice('${notice.id}')" class="btn-action-text"><i class="fa-solid fa-print"></i></button>
                        <button onclick="copyNotice('${notice.id}')" class="btn-action-text"><i class="fa-solid fa-copy"></i></button>
                        <button onclick="shareNotice('${notice.id}')" class="btn-action-text"><i class="fa-solid fa-share-nodes"></i></button>
                        ${adminControls}
                    </div>
                </div>
            `;
            return card;
        }

        function escapeHtml(str) { if (!str) return ''; return str.replace(/[&<>"']/g, m => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[m])); }

        // ===== NOTICE ACTIONS =====
        function printNotice(id) { const el = document.getElementById(`notice-${id}`); if(!el)return; el.classList.add('printable'); window.print(); el.classList.remove('printable'); }
        function copyNotice(id) {
            const n = notices.find(x => x.id === id); if(!n)return;
            const txt = `[${n.category}] ${n.title}\nDate: ${n.date} Time: ${n.time}\nPosted: ${n.postedBy}${n.description ? '\n\n'+n.description : ''}`;
            navigator.clipboard.writeText(txt).then(()=>showToast('✅ Copied!','success')).catch(()=>showToast('Copy failed','error'));
        }
        function shareNotice(id) {
            const n = notices.find(x => x.id === id); if(!n)return;
            if (navigator.share) { navigator.share({ title: n.title, text: n.description || n.title, url: window.location.href }).catch(()=>{}); }
            else { copyNotice(id); }
        }

        function updateSyncTime() {
            const el = document.getElementById('lastSyncTime');
            if (el) {
                el.textContent = isFirebaseReady ? 'active' : 'cached';
            }
        }

        // ===== ADMIN: CRUD WITH FIREBASE =====
        function openAdminDashboard() { resetNoticeForm(); document.getElementById('adminModal').classList.remove('hidden'); }
        function resetNoticeForm() {
            document.getElementById('noticeForm').reset();
            document.getElementById('noticeId').value = '';
            document.getElementById('saveNoticeBtn').textContent = 'Publish Notice';
            const now = new Date();
            document.getElementById('formDate').value = now.toISOString().split('T')[0];
            document.getElementById('formTime').value = now.toTimeString().slice(0,5);
        }

        async function saveNoticeFromForm() {
            const id = document.getElementById('noticeId').value;
            const title = document.getElementById('formTitle').value.trim();
            const category = document.getElementById('formCategory').value;
            const date = document.getElementById('formDate').value;
            const time = document.getElementById('formTime').value;
            const postedBy = document.getElementById('formPostedBy').value;
            const attachment = document.getElementById('formAttachment').value.trim();
            const description = document.getElementById('formDescription').value.trim();
            const pinned = document.getElementById('formPinned').checked;
            if (!title || !date || !time) return showToast('Please fill all required fields.', 'error');

            try {
                if (id) {
                    const noticeData = { id, title, category, date, time, postedBy, attachment, description, pinned };
                    await updateNoticeInFirebase(id, noticeData);
                    showToast('✅ Notice updated!', 'success');
                } else {
                    const noticeData = { title, category, date, time, postedBy, attachment, description, pinned };
                    await addNoticeToFirebase(noticeData);
                    showToast('✅ Notice published!', 'success');
                }
                document.getElementById('adminModal').classList.add('hidden');
            } catch (error) {
                console.error('Save error:', error);
                showToast('❌ Error saving notice.', 'error');
            }
        }

        function openEditModal(id) {
            const n = notices.find(x => x.id === id); if(!n)return;
            document.getElementById('noticeId').value = n.id;
            document.getElementById('formTitle').value = n.title;
            document.getElementById('formCategory').value = n.category;
            document.getElementById('formDate').value = n.date;
            document.getElementById('formTime').value = n.time;
            document.getElementById('formPostedBy').value = n.postedBy;
            document.getElementById('formAttachment').value = n.attachment || '';
            document.getElementById('formDescription').value = n.description || '';
            document.getElementById('formPinned').checked = n.pinned;
            document.getElementById('saveNoticeBtn').textContent = 'Save Changes';
            document.getElementById('adminModal').classList.remove('hidden');
        }

        async function togglePin(id) {
            const n = notices.find(x => x.id === id); if(!n)return;
            try {
                await updateNoticeInFirebase(id, { ...n, pinned: !n.pinned });
                showToast(n.pinned ? '📌 Pinned!' : 'Unpinned', 'info');
            } catch (error) {
                showToast('❌ Error toggling pin', 'error');
            }
        }

        function confirmDelete(id) { 
            deleteTargetId = id; 
            document.getElementById('deleteModal').classList.remove('hidden'); 
        }

        async function confirmDeleteNotice() {
            if (deleteTargetId) {
                try {
                    await deleteNoticeFromFirebase(deleteTargetId);
                    document.getElementById('deleteModal').classList.add('hidden');
                    deleteTargetId = null;
                    showToast('🗑️ Notice deleted', 'success');
                } catch (error) {
                    showToast('❌ Error deleting notice', 'error');
                }
            }
        }

        // ===== EVENT LISTENERS =====
        function setupEventListeners() {
            document.getElementById('refreshBtn').addEventListener('click', refreshPage);

            const btt = document.getElementById('backToTop');
            window.addEventListener('scroll', () => { btt.classList.toggle('visible', window.scrollY > 300); });
            btt.addEventListener('click', () => window.scrollTo({ top:0, behavior:'smooth' }));

            document.querySelectorAll('.closeModal').forEach(btn => {
                btn.addEventListener('click', () => { btn.closest('.modal-overlay').classList.add('hidden'); });
            });

            document.getElementById('adminBtn').addEventListener('click', () => {
                if (isAdmin) { openAdminDashboard(); }
                else { document.getElementById('authModal').classList.remove('hidden'); document.getElementById('pinInput').value=''; document.getElementById('pinError').classList.add('hidden'); document.getElementById('pinInput').focus(); }
            });

            document.getElementById('authForm').addEventListener('submit', (e) => {
                e.preventDefault();
                if (document.getElementById('pinInput').value === ADMIN_PIN) {
                    isAdmin = true;
                    document.getElementById('authModal').classList.add('hidden');
                    openAdminDashboard();
                    renderNotices();
                    showToast('🔓 Admin access granted', 'success');
                } else { document.getElementById('pinError').classList.remove('hidden'); }
            });

            document.getElementById('adminLogoutBtn').addEventListener('click', () => {
                isAdmin = false;
                document.getElementById('adminModal').classList.add('hidden');
                renderNotices();
                showToast('🔒 Logged out', 'info');
            });

            document.getElementById('noticeForm').addEventListener('submit', (e) => { e.preventDefault(); saveNoticeFromForm(); });
            document.getElementById('resetFormBtn').addEventListener('click', resetNoticeForm);

            document.getElementById('cancelDeleteBtn').addEventListener('click', () => { document.getElementById('deleteModal').classList.add('hidden'); deleteTargetId = null; });
            document.getElementById('confirmDeleteBtn').addEventListener('click', confirmDeleteNotice);

            document.getElementById('prevMonth').addEventListener('click', () => { currentCalendarDate.setMonth(currentCalendarDate.getMonth()-1); renderCalendar(); });
            document.getElementById('nextMonth').addEventListener('click', () => { currentCalendarDate.setMonth(currentCalendarDate.getMonth()+1); renderCalendar(); });
            document.getElementById('clearDateFilter').addEventListener('click', () => { selectedDateStr = null; document.getElementById('clearDateFilter').classList.add('hidden'); renderCalendar(); renderNotices(); });
        }

        // ===== INIT =====
        function init() {
            loadNoticesFromCache();
            initTheme();
            requestNotificationPermission();
            setupEventListeners();

            try {
                startFirebaseListener();
            } catch (error) {
                console.error('Firebase init error:', error);
            }
        }

        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
